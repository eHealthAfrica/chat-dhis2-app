# ─────────────────────────────────────────────────────────────
# CHAT E2E configuration
# Copy to `apps/chat-app/e2e/.env` and fill in for your DHIS2 instance.
# All values target the Playwright harness — the app itself derives config
# at runtime from the DHIS2 app-runtime (no VITE_/import.meta.env vars).
# ─────────────────────────────────────────────────────────────

# Base URL of the DHIS2 2.41+ instance the app is served from / points at.
DHIS2_BASE_URL=http://localhost:8080

# Path the CHAT app is served from on the instance.
# Default assumes the app is installed as "chat" via the App Management app.
# For `d2-app-scripts start` dev server, set this to "/" and point
# DHIS2_BASE_URL at the dev server URL instead.
APP_PATH=/api/apps/chat/index.html

# Admin fixture — MUST have the F_CHAT_ADD_SETTINGS authority.
DHIS2_ADMIN_USERNAME=admin
# Set your own password; never commit real credentials.
DHIS2_ADMIN_PASSWORD=

# Data-capture fixture — MUST NOT have F_CHAT_ADD_SETTINGS.
DHIS2_CAPTURE_USERNAME=capture_user
DHIS2_CAPTURE_PASSWORD=

# Seeded IDs surfaced to specs. If left blank, global setup seeds a program
# and org unit and writes the resolved IDs back for the run.
E2E_PROGRAM_ID=
E2E_ORG_UNIT_ID=

# Optional: skip seeding (assume the instance is already provisioned).
# E2E_SKIP_SEED=1

# Optional: skip teardown (leave seeded data in place for debugging).
# E2E_SKIP_TEARDOWN=1
